# Database connection
DATABASE_URL=your_postgres_connection_string

# External rates API URL (required for auto-sync)
# The API should return JSON in this format:
# { "24K Gold": 145000, "22K Gold": 133400, "18K Gold": 116000, "Silver": 2280 }
EXTERNAL_RATES_URL=https://your-api-endpoint.com/rates

# Server port (optional, defaults to 3000)
PORT=3000
